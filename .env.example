# Environment configuration (development | production | test)
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=hotel-pms-super-secret-key-change-in-production-min-32-chars
DATABASE_URL=sqlite:///./hotel_pms.db
REDIS_URL=redis://localhost:6379/0

# Stripe Subscriptions & Payments (Leave empty for simulated/manual fallback mode)
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_PUBLISHABLE_KEY=pk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
STRIPE_PRICE_STARTER=price_starter_mock
STRIPE_PRICE_PRO=price_pro_mock
STRIPE_PRICE_ENTERPRISE=price_enterprise_mock

# Email Service (Leave empty to log emails to console)
SENDGRID_API_KEY=
MAIL_FROM="Hotel OS <hello@checkinos.com>"

# Daily Backups & Data Export Storage (Leave empty for local storage fallback in ./backups)
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Error Tracking & Observability
SENTRY_DSN=
SENTRY_DSN_FRONTEND=
SENTRY_ENVIRONMENT=development

# Support & Live Chat (Optional)
CRISP_WEBSITE_ID=
HELP_WIDGET_ENABLED=true

# Domain & CORS
ROOT_DOMAIN=checkinos.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# SMS Provider (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
